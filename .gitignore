runs/**/live.jsonl
runs/**/*-live.jsonl
runs/**/live-*.jsonl
runs/progress.log
runs/verbalize-live.jsonl
runs/pods.txt
# staging copies for Kaggle uploads
infra/kaggle/dataset*/*
!infra/kaggle/dataset*/dataset-metadata.json
# pod mirror bookkeeping
runs/finetune/logs-*/
runs/finetune/last_mirror.txt
